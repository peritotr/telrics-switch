<!DOCTYPE scenario SYSTEM "sipp.dtd">
<!-- A vendor for the scenarios about fax and key presses (ADR-0031; the
     caller is uac-fax.xml). It answers the call with PCMA and key presses,
     then follows one plan:
       __PLAN__  "full": the caller's offer of T.38 must arrive through the
                 media relay as it was made (m=image udptl t38 and its
                 attributes, no audio, no codec of the connection's list);
                 the caller's key press (INFO) must arrive unchanged. Then
                 this vendor sends a key press of its own, goes back to
                 audio with an offer of PCMU and PCMA, turns the call into a
                 fax itself, and takes the caller's offer back to audio
                 (relayed, the connection's codecs only). Waits for the BYE.
                 "take": takes the caller's offer of T.38, then waits for
                 the BYE.
     A request that is not as expected is refused with 488 (an INFO with
     415) and this scenario fails: a failed check alone would not stop
     SIPp. Before each request of its own it waits 200 ms: SIPp takes a
     request that arrives while the caller is still between its own steps
     for an unexpected one. -->
<scenario name="uas-fax">
  <recv request="INVITE" crlf="true" rrs="true">
    <action>
      <ereg regexp="c=IN IP4 172\.30\.0\.11" search_in="body" assign_to="relayed" />
      <ereg regexp=".*" search_in="hdr" header="From:" assign_to="from" />
      <ereg regexp=".*" search_in="hdr" header="To:" assign_to="to" />
    </action>
  </recv>
  <nop test="relayed" next="accept" />
  <send>
    <![CDATA[
      SIP/2.0 488 Not Acceptable Here
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>
  <recv request="ACK" />
  <nop next="bad" />

  <label id="accept" />
  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=vendor 4242 1 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
    ]]>
  </send>
  <recv request="ACK" crlf="true" />

  <!-- 1. The caller turns the call into a fax. -->
  <recv request="INVITE" timeout="10000" ontimeout="bad">
    <action>
      <ereg regexp="c=IN IP4 172\.30\.0\.11" search_in="body" assign_to="relayed1" />
      <ereg regexp="m=image [1-9][0-9]* udptl t38" search_in="body" assign_to="fax1" />
      <ereg regexp="a=T38FaxRateManagement:transferredTCF" search_in="body" assign_to="tcf1" />
      <ereg regexp="a=T38FaxMaxDatagram:176" search_in="body" assign_to="datagram1" />
      <ereg regexp="a=T38FaxUdpEC:t38UDPRedundancy" search_in="body" assign_to="ec1" />
      <ereg regexp="m=audio [1-9]|a=rtpmap" search_in="body" assign_to="audio1" />
    </action>
  </recv>
  <nop test="audio1" next="refuse" />
  <nop test="relayed1" next="c1" />
  <nop next="refuse" />
  <label id="c1" />
  <nop test="fax1" next="c2" />
  <nop next="refuse" />
  <label id="c2" />
  <nop test="tcf1" next="c3" />
  <nop next="refuse" />
  <label id="c3" />
  <nop test="datagram1" next="c4" />
  <nop next="refuse" />
  <label id="c4" />
  <nop test="ec1" next="c5" />
  <nop next="refuse" />
  <label id="c5" />
  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=vendor 4242 2 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=image [media_port] udptl t38
      a=T38FaxVersion:0
      a=T38MaxBitRate:14400
      a=T38FaxRateManagement:transferredTCF
      a=T38FaxMaxBuffer:262
      a=T38FaxMaxDatagram:176
      a=T38FaxUdpEC:t38UDPRedundancy
    ]]>
  </send>
  <recv request="ACK" />
  <nop next="__PLAN__" />

  <!-- full -->
  <label id="full" />
  <!-- 2. The caller's key press, unchanged. -->
  <recv request="INFO" timeout="10000" ontimeout="bad">
    <action>
      <ereg regexp="application/dtmf-relay" search_in="hdr" header="Content-Type:" assign_to="type2" />
      <ereg regexp="Signal=5\r?\nDuration=160" search_in="body" assign_to="key2" />
    </action>
  </recv>
  <nop test="type2" next="d1" />
  <nop next="unsupported" />
  <label id="d1" />
  <nop test="key2" next="d2" />
  <nop next="unsupported" />
  <label id="d2" />
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <!-- 3. A key press of this vendor's. -->
  <pause milliseconds="200" />
  <send retrans="500">
    <![CDATA[
      INFO [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=z9hG4bK-[pid]-[call_number]-vi1
      From:[$to];tag=[pid]SIPpTag01[call_number]
      To:[$from]
      Call-ID: [call_id]
      CSeq: 1 INFO
      Max-Forwards: 70
      Content-Type: application/dtmf-relay
      Content-Length: [len]

      Signal=9
      Duration=250
    ]]>
  </send>
  <recv response="200">
    <action>
      <ereg regexp="^ *1 INFO" search_in="hdr" header="CSeq:" assign_to="cseq3" />
    </action>
  </recv>
  <nop test="cseq3" next="d3" />
  <nop next="bad" />
  <label id="d3" />

  <!-- 4. Back to audio, offering PCMU too. -->
  <pause milliseconds="200" />
  <send retrans="500">
    <![CDATA[
      INVITE [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=z9hG4bK-[pid]-[call_number]-v4
      From:[$to];tag=[pid]SIPpTag01[call_number]
      To:[$from]
      Call-ID: [call_id]
      CSeq: 2 INVITE
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Max-Forwards: 70
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=vendor 4242 3 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0 8 101
      a=rtpmap:0 PCMU/8000
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
    ]]>
  </send>
  <recv response="100" optional="true" />
  <recv response="200">
    <action>
      <ereg regexp="^ *2 INVITE" search_in="hdr" header="CSeq:" assign_to="cseq4" />
      <ereg regexp="c=IN IP4 172\.30\.0\.11" search_in="body" assign_to="relayed4" />
      <ereg regexp="m=audio [1-9][0-9]* RTP/AVP 8 101" search_in="body" assign_to="audio4" />
    </action>
  </recv>
  <send>
    <![CDATA[
      ACK [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=z9hG4bK-[pid]-[call_number]-v4ack
      From:[$to];tag=[pid]SIPpTag01[call_number]
      To:[$from]
      Call-ID: [call_id]
      CSeq: 2 ACK
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>
  <nop test="cseq4" next="d4" />
  <nop next="bad" />
  <label id="d4" />
  <nop test="relayed4" next="d5" />
  <nop next="bad" />
  <label id="d5" />
  <nop test="audio4" next="d6" />
  <nop next="bad" />
  <label id="d6" />

  <!-- 5. This vendor turns the call into a fax. -->
  <pause milliseconds="200" />
  <send retrans="500">
    <![CDATA[
      INVITE [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=z9hG4bK-[pid]-[call_number]-v5
      From:[$to];tag=[pid]SIPpTag01[call_number]
      To:[$from]
      Call-ID: [call_id]
      CSeq: 3 INVITE
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Max-Forwards: 70
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=vendor 4242 4 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=image [media_port] udptl t38
      a=T38FaxVersion:0
      a=T38MaxBitRate:14400
      a=T38FaxRateManagement:transferredTCF
      a=T38FaxMaxBuffer:262
      a=T38FaxMaxDatagram:176
      a=T38FaxUdpEC:t38UDPRedundancy
    ]]>
  </send>
  <recv response="100" optional="true" />
  <recv response="200">
    <action>
      <ereg regexp="^ *3 INVITE" search_in="hdr" header="CSeq:" assign_to="cseq5" />
      <ereg regexp="c=IN IP4 172\.30\.0\.11" search_in="body" assign_to="relayed5" />
      <ereg regexp="m=image [1-9][0-9]* udptl t38" search_in="body" assign_to="fax5" />
      <ereg regexp="a=T38FaxUdpEC:t38UDPRedundancy" search_in="body" assign_to="ec5" />
    </action>
  </recv>
  <send>
    <![CDATA[
      ACK [next_url] SIP/2.0
      Via: SIP/2.0/[transport] [local_ip]:[local_port];branch=z9hG4bK-[pid]-[call_number]-v5ack
      From:[$to];tag=[pid]SIPpTag01[call_number]
      To:[$from]
      Call-ID: [call_id]
      CSeq: 3 ACK
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>
  <nop test="cseq5" next="d7" />
  <nop next="bad" />
  <label id="d7" />
  <nop test="relayed5" next="d8" />
  <nop next="bad" />
  <label id="d8" />
  <nop test="fax5" next="d9" />
  <nop next="bad" />
  <label id="d9" />
  <nop test="ec5" next="d10" />
  <nop next="bad" />
  <label id="d10" />

  <!-- 6. The caller goes back to audio. -->
  <recv request="INVITE" timeout="10000" ontimeout="bad">
    <action>
      <ereg regexp="c=IN IP4 172\.30\.0\.11" search_in="body" assign_to="relayed6" />
      <ereg regexp="m=audio [1-9][0-9]* RTP/AVP 8 101" search_in="body" assign_to="listed6" />
      <ereg regexp="PCMU|m=image [1-9]" search_in="body" assign_to="unlisted6" />
    </action>
  </recv>
  <nop test="unlisted6" next="refuse" />
  <nop test="relayed6" next="d11" />
  <nop next="refuse" />
  <label id="d11" />
  <nop test="listed6" next="d12" />
  <nop next="refuse" />
  <label id="d12" />
  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=vendor 4242 5 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8 101
      a=rtpmap:8 PCMA/8000
      a=rtpmap:101 telephone-event/8000
    ]]>
  </send>
  <recv request="ACK" />
  <nop next="take" />

  <!-- take; and the end of every plan: the caller's BYE. -->
  <label id="take" />
  <recv request="BYE" timeout="__WAIT__" ontimeout="bad" />
  <send next="done">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <!-- A key press that is not as expected. -->
  <label id="unsupported" />
  <send next="bad">
    <![CDATA[
      SIP/2.0 415 Unsupported Media Type
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

  <!-- A new offer that is not as expected. -->
  <label id="refuse" />
  <send>
    <![CDATA[
      SIP/2.0 488 Not Acceptable Here
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>
  <recv request="ACK" />

  <label id="bad" />
  <nop><action><error message="fax or key presses within the call were not as expected" /></action></nop>

  <label id="done" />
  <Reference variables="from,to" />
</scenario>
