<!DOCTYPE scenario SYSTEM "sipp.dtd">
<!-- A vendor that takes the switch's registration (T-14, ADR-0035) and its
     calls. A REGISTER must come from the SIP core's own address (Via and
     Contact at 172.30.0.10:5060), for the address of record connlab.sh puts
     here; without credentials it is asked to sign in (401, MD5), with the
     right ones it is taken for __EXPIRES__ seconds, whatever was asked for.
     The registration's next REGISTERs (the refreshes) come with the same
     Call-ID and go round the same loop; after __COUNT__ registrations taken
     the scenario ends. A wrong password, or a REGISTER of another shape, is
     asked again (401) and the scenario ends there: the switch tries again
     later with a new Call-ID, which is another "call" here. An INVITE is
     answered and talked through like any vendor's. -->
<scenario name="uas-registrar">
  <recv request="REGISTER" optional="true" next="got" crlf="true">
    <action>
      <!-- A header missing from this REGISTER leaves what the last one set:
           every flag starts afresh. -->
      <assign assign_to="signed" value="0" />
      <assign assign_to="good" value="0" />
      <assign assign_to="via" value="0" />
      <assign assign_to="bound" value="0" />
      <assign assign_to="aor" value="0" />
      <ereg regexp="Digest" search_in="hdr" header="Authorization:" assign_to="signed" />
      <verifyauth assign_to="good" username="__USER__" password="__PASS__" />
      <ereg regexp="172\.30\.0\.10:5060" search_in="hdr" header="Via:" assign_to="via" />
      <ereg regexp="&lt;?sip:__USER__@172\.30\.0\.10:5060" search_in="hdr" header="Contact:" assign_to="bound" />
      <ereg regexp="sip:__USER__@__DOMAIN__" search_in="hdr" header="To:" assign_to="aor" />
    </action>
  </recv>
  <recv request="INVITE" crlf="true" />
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      [last_Record-Route:]
      Contact: <sip:[local_ip]:[local_port];transport=[transport]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=user1 53655765 2353687637 IN IP[local_ip_type] [local_ip]
      s=-
      c=IN IP[media_ip_type] [media_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 8
      a=rtpmap:8 PCMA/8000
    ]]>
  </send>
  <recv request="ACK" optional="true" crlf="true" />
  <recv request="BYE" />
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>
  <nop next="done" />

  <label id="wait" />
  <recv request="REGISTER" crlf="true">
    <action>
      <!-- A header missing from this REGISTER leaves what the last one set:
           every flag starts afresh. -->
      <assign assign_to="signed" value="0" />
      <assign assign_to="good" value="0" />
      <assign assign_to="via" value="0" />
      <assign assign_to="bound" value="0" />
      <assign assign_to="aor" value="0" />
      <ereg regexp="Digest" search_in="hdr" header="Authorization:" assign_to="signed" />
      <verifyauth assign_to="good" username="__USER__" password="__PASS__" />
      <ereg regexp="172\.30\.0\.10:5060" search_in="hdr" header="Via:" assign_to="via" />
      <ereg regexp="&lt;?sip:__USER__@172\.30\.0\.10:5060" search_in="hdr" header="Contact:" assign_to="bound" />
      <ereg regexp="sip:__USER__@__DOMAIN__" search_in="hdr" header="To:" assign_to="aor" />
    </action>
  </recv>
  <label id="got" />
  <nop test="via" next="via_ok" />
  <nop next="again" />
  <label id="via_ok" />
  <nop test="bound" next="bound_ok" />
  <nop next="again" />
  <label id="bound_ok" />
  <nop test="aor" next="aor_ok" />
  <nop next="again" />
  <label id="aor_ok" />
  <nop test="good" next="take" />
  <nop test="signed" next="again" />
  <!-- The next REGISTER comes at once: the jump goes with the answer, or it
       would find the call between two steps. -->
  <send next="wait">
    <![CDATA[
      SIP/2.0 401 Unauthorized
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      WWW-Authenticate: Digest realm="lab.vendor", nonce="[pid]n[call_number]x[clock_tick]", algorithm=MD5
      Content-Length: 0
    ]]>
  </send>

  <!-- Not taken: asked again, and this registration attempt is over. -->
  <label id="again" />
  <send next="done">
    <![CDATA[
      SIP/2.0 401 Unauthorized
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      WWW-Authenticate: Digest realm="lab.vendor", nonce="[pid]r[call_number]x[clock_tick]", algorithm=MD5
      Content-Length: 0
    ]]>
  </send>

  <label id="take" />
  <nop>
    <action>
      <add assign_to="taken" value="1" />
      <test assign_to="enough" variable="taken" compare="greater_than_equal" value="__COUNT__" />
    </action>
  </nop>
  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[pid]SIPpTag01[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:__USER__@172.30.0.10:5060>;expires=__EXPIRES__
      Content-Length: 0
    ]]>
  </send>
  <nop test="enough" next="done" />
  <nop next="wait" />

  <label id="done" />
  <!-- The last answer may need sending again; a moment to be asked. -->
  <pause milliseconds="300" />
</scenario>
