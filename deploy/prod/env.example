# SPDX-License-Identifier: AGPL-3.0-only
# Settings of a single-server installation. install.sh copies this to .env
# and fills in the secrets; .env is never committed. Guide: docs/09-kurulum.md

# How the call path is attached to the network (see docker-compose.yml).
COMPOSE_FILE=docker-compose.yml:docker-compose.host.yml

# ---- addresses -----------------------------------------------------------
# The address SIP is served on. On a server with a public address, that
# address. Behind one-to-one address translation (most clouds): the private
# address here and the public one in SIP_ADVERTISED_IP.
SIP_IP=
SIP_ADVERTISED_IP=
# IPv6 (optional): the server's IPv6 address, served besides SIP_IP on the
# same ports; SIP_ADVERTISED_IP6 only behind translation of IPv6 addresses.
# Empty: IPv4 only.
SIP_IP6=
SIP_ADVERTISED_IP6=
# The address media is sent from: the same address, or "private!public"
# behind address translation. With IPv6, add its address after a
# semicolon ("203.0.113.10;2001:db8::10"): the relay then bridges callers
# and vendors of either family.
RTP_INTERFACE=
RTP_PORT_MIN=30000
RTP_PORT_MAX=39999

# ---- SIP -----------------------------------------------------------------
# Trunk passwords are bound to the realm: changing it voids all of them.
SIP_REALM=softswitch
UDP_WORKERS=16
OPENSIPS_SHM_MB=1024
RTP_THREADS=8
# -1: media stays in user space. 0 and up: kernel forwarding (see the guide).
RTP_KERNEL_TABLE=-1
# A call with no media either way for this many seconds is ended on both
# sides (a dead call); on hold, where one side is not meant to send, the
# second figure applies.
RTP_TIMEOUT=60
RTP_HOLD_TIMEOUT=3600
# A file of authorities a vendor's TLS certificate may be signed by, as seen
# inside the container (certs/ is mounted at /etc/opensips-tls). Empty: the
# public authorities the system trusts.
TLS_CA_LIST=
# The engine looks at every TLS vendor's certificate and sends no calls to
# one that is not made out to the vendor (the connection's host, or the name
# set on the connection) by one of those authorities. "off" leaves the names
# unchecked; the SIP core then only checks the signature.
PEER_VERIFY=on
# Registrations (trunks that sign in and tell where they are), in seconds:
# the least and the most a trunk may ask for, and the most a trunk behind
# address translation (NAT), or connected over TCP or TLS, is given. Such a
# trunk must register again before then, which is what keeps the path to it
# open: lower REG_NAT_EXPIRES if calls to trunks behind NAT go missing.
REG_MIN_EXPIRES=60
REG_MAX_EXPIRES=3600
REG_NAT_EXPIRES=60
# Registering with vendors that ask for it (the connection's "register"
# setting), in seconds: how often the SIP core looks at its registrations
# (each is renewed this long before it runs out; at least 10), and how long
# one that failed waits before it is tried again.
REG_TIMER_SEC=30
REG_RETRY_SEC=60
# A file of authorities a caller's TLS certificate may be signed by (same
# place). Needed for trunks that demand a client certificate. Empty: callers
# are not asked for one. Once set, a caller that presents a certificate
# these authorities did not sign cannot connect over TLS at all.
TLS_CLIENT_CA=
# The name customers and vendors reach SIP over TLS by. With the "https"
# profile, a certificate for it is obtained and renewed automatically (the
# name must point at this server; ports 80 and 443 open). Empty: the files
# in certs/ (opensips.crt, opensips.key) are yours to replace; a replaced
# file is loaded within a minute, without a restart.
SIP_DOMAIN=

# Codec translation (transcoding): the most calls the media relay may
# translate at once, for connections and trunks that allow it. Translation
# takes the relay's processor; measure before raising it (see the guide).
# 0: no call is translated.
TRANSCODE_MAX=200

# ---- call records ----------------------------------------------------------
# The engine keeps call records on disk (the engine-journal volume) until
# NATS has them. The most room they may take, in megabytes: at 1,000 calls a
# second about an hour of a NATS outage per gigabyte. When it is full the
# records wait in memory, as they did before the journal (see the guide).
CDR_JOURNAL_MAX_MB=1024

# ---- configuration loads --------------------------------------------------
# The engine reads rates again only where they changed, and every rate this
# often, in seconds, should a change ever be missed. 0 reads every rate on
# every load (about 8 seconds for 5 million rates).
RELOAD_FULL_SEC=300

# ---- panel ---------------------------------------------------------------
# The API and panel listen on 127.0.0.1:API_PORT. To serve the panel over
# HTTPS from this server, set the domain and COMPOSE_PROFILES=https.
API_PORT=58080
PANEL_DOMAIN=
PANEL_URL=
COMPOSE_PROFILES=

# ---- monitoring ------------------------------------------------------------
# Add "monitoring" to COMPOSE_PROFILES (comma separated) for Prometheus and
# Alertmanager on 127.0.0.1:59090 and :59093. Who is told about an alert is
# set in monitoring/alertmanager.yml.
METRICS_KEEP=30d

# ---- call traces -----------------------------------------------------------
# The SIP messages of every carried call are stored (ClickHouse) for the
# panel's call trace and its capture file, for this many days. At full load
# this is the largest thing on the disk: see the guide for the sizing.
TRACE_KEEP_DAYS=7
# To store none, uncomment (an empty value turns the copy off):
#TRACE_TARGET=
# The same copy can also go to a HEP collector of your own (Homer),
# address:port. Empty: none.
HEP_TARGET=

# Call records. PostgreSQL keeps every one by default. With CDR_KEEP_DAYS
# the rater removes those older than that many days from PostgreSQL, each
# only after ClickHouse has confirmed it holds it; set CDR_LIST_SOURCE too,
# or the panel's list will no longer show them. The CSV export and single
# records still read PostgreSQL. Not for the Enterprise edition, whose
# invoices and portal read PostgreSQL.
CDR_KEEP_DAYS=0
# "clickhouse": the list of call records is read from ClickHouse.
CDR_LIST_SOURCE=

# ---- e-mail (optional): SMTP_URL or RESEND_API_KEY, with MAIL_FROM --------
MAIL_FROM=
SMTP_URL=
RESEND_API_KEY=

# ---- secrets: filled in by install.sh --------------------------------------
PG_PASSWORD=
CLICKHOUSE_PASSWORD=
BOOTSTRAP_API_KEY=
# What the route-engine expects from its callers (the SIP core, the API and
# your own scripts: "Authorization: Bearer <value>"). Letters, digits and
# - . _ ~ + / = only. To change it, write the new value and run
# `docker compose up -d`: the three services restart, calls in progress drop.
ENGINE_TOKEN=
# Seals the panel users' two-step sign-in secrets and the passwords the
# switch signs in to vendors with in the database: 64 hexadecimal digits
# (install.sh makes it). The API and the route-engine both get it. Keep it
# with your backups: a database restored without it cannot check those
# users' codes (an administrator then has to reset their two-step sign-in)
# and the vendors' passwords have to be entered again.
SECRET_KEY=

# ---- audit log -------------------------------------------------------------
# Every change made through the API and the panel is recorded (who, when,
# from where, what). Records older than this many days are removed; 0 keeps
# them for ever.
AUDIT_RETENTION_DAYS=365
# 1 when a reverse proxy in front of the API sets X-Forwarded-For (the
# "https" profile does; install.sh sets it with --domain). The audit log then
# records the caller's address instead of the proxy's. Leave empty when the
# API is reached directly: the header would be whatever the caller says.
TRUST_PROXY=

# ---- rates of exchange -------------------------------------------------------
# ecb: rates marked "ECB" in the panel follow the European Central Bank's
# daily reference rates (free, no key; the API fetches once a day after the
# bank publishes, and when it starts). Typed-in rates are never changed.
# Empty: every rate is typed in. The API needs to reach www.ecb.europa.eu
# over HTTPS; FX_URL points elsewhere (a mirror of the same file).
FX_SOURCE=
FX_URL=
